# divmcp configuration. Copy to .env and fill in. Never commit .env.

# Web search "sense" (Tavily). Absent/placeholder => web_search fails soft.
TAVILY_API_KEY=

# Market-news "sense" (Exa). Absent/placeholder => market_news fails soft.
EXA_API_KEY=

# fetch_url safety limits.
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_CHARS=8000
