# Application
PROJECT_NAME="Dividend - FA Cloud"
VERSION="26.2.11"
ADMIN_PASSWORD="change-me"
SECRET_KEY="change-me"
ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Database
